          "rawQuery": true,
          "rawSql": "SELECT source, device, sensor, unit, value_real, value_text, quality, in_device_catalog, ts FROM (SELECT DISTINCT ON (source, device, sensor) source, device, sensor, unit, value_real, value_text, quality, in_device_catalog, ts FROM v_sensor_readings WHERE (CASE WHEN '__all__' IN ([[source:sqlstring]]) THEN TRUE ELSE source IN ([[source:sqlstring]]) END) AND (CASE WHEN '__all__' IN ([[device:sqlstring]]) THEN TRUE ELSE device IN ([[device:sqlstring]]) END) AND (CASE WHEN '__all__' IN ([[sensor:sqlstring]]) THEN TRUE ELSE sensor IN ([[sensor:sqlstring]]) END) ORDER BY source, device, sensor, ts DESC) latest ORDER BY source, device, sensor",
