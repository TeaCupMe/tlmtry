          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), device || ' / ' || sensor || CASE WHEN unit <> '' THEN ' (' || unit || ')' ELSE '' END AS metric, AVG(value_real) AS value FROM v_sensor_readings WHERE $__timeFilter(ts) AND value_real IS NOT NULL AND (CASE WHEN '__all__' IN ([[source:sqlstring]]) THEN TRUE ELSE source IN ([[source:sqlstring]]) END) AND (CASE WHEN '__all__' IN ([[device:sqlstring]]) THEN TRUE ELSE device IN ([[device:sqlstring]]) END) AND (CASE WHEN '__all__' IN ([[sensor:sqlstring]]) THEN TRUE ELSE sensor IN ([[sensor:sqlstring]]) END) GROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Показания",
      "type": "timeseries"
